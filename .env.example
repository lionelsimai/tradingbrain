# TradingBrain — environment template. Copy to .env and fill in. NEVER commit .env.
# ---- Trading mode (safety) ----
TB_MODE=paper            # backtest | paper | live   (default: paper)
TB_ALLOW_LIVE=0          # must be 1 for live mode to be permitted (fail-closed)
TB_HUMAN_APPROVED=0      # set 1 to approve trades flagged for human review
TB_SEED=7                # RNG seed for reproducible research runs

# ---- Broker (Alpaca PAPER sandbox only) ----
APCA_API_KEY_ID=         # paper key id
APCA_API_SECRET_KEY=     # paper secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2

# ---- Optional data vendors (live ingestion) ----
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=

# ---- moomoo OpenAPI / OpenD (market data only; keep trading disabled) ----
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
